+    const realTests = getRealTests(r.id, 'deck');
+    const hasReal = realTests.length > 0;
+    return `<div class="rank-card ${openRanks[r.id]?'open':''}" id="card-${r.id}" style="animation:fadeIn 0.35s ${i*60}ms ease both">
