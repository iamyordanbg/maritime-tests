+// ===== Library selection confirm modal =====
+var pendingLibTestId = null;
+
+function openLibConfirm(testId, testTitle){
+  if (libState.is_premium || libState.window_active) return; // вече има избор / не е нужен
+  pendingLibTestId = testId;
+  document.getElementById('libConfirmTestName').textContent = testTitle;
+  document.getElementById('libConfirmOverlay').classList.add('show');
+}
+
+function closeLibConfirm(){
+  pendingLibTestId = null;
+  document.getElementById('libConfirmOverlay').classList.remove('show');
+}
+
+function confirmLibrarySelection(){
+  if (!pendingLibTestId) return;
+  const btn = document.getElementById('libConfirmNextBtn');
+  btn.disabled = true;
+  btn.textContent = '...';
+  fetch('/library/select', {
+    method: 'POST',
+    headers: {'Content-Type': 'application/json'},
+    body: JSON.stringify({test_id: pendingLibTestId})
+  })
+  .then(r => r.json())
+  .then(data => {
+    if (data.success) {
+      sessionStorage.setItem('libJustSelected', '1');
+      window.location.href = "{{ url_for('dashboard.user_dashboard') }}";
+    } else {
+      btn.disabled = false;
+      btn.textContent = 'Next';
+      alert(data.message || 'Грешка. Опитай отново.');
+    }
+  })
+  .catch(() => {
+    btn.disabled = false;
+    btn.textContent = 'Next';
+    alert('Грешка в мрежата. Опитай отново.');
+  });
+}
+
+// Пулсиращ ефект на брояча в хедъра при свеж избор/рефреш на прозореца
+(function(){
+  if (sessionStorage.getItem('libJustSelected') === '1') {
+    sessionStorage.removeItem('libJustSelected');
+    var c = document.getElementById('libCounter');
+    if (c) { c.classList.add('pulse'); setTimeout(()=>c.classList.remove('pulse'), 1700); }
+  }
+})();
+
+function toggleDD(btn) {
+  var dd = btn.nextElementSibling;
+  var arrow = btn.querySelector('span');
+  var isOpen = dd.style.display === 'block';
+  document.querySelectorAll('.ddm').forEach(function(d){ d.style.display='none'; });
+  document.querySelectorAll('.ddm-arrow').forEach(function(a){ a.style.transform=''; });
+  if (!isOpen) {
+    dd.style.display = 'block';
+    if (arrow) arrow.style.transform = 'rotate(180deg)';
+    var el = btn.parentElement;
+    for (var i=0; i<8; i++) {
+      if (!el || el.tagName === 'BODY') break;
+      el.style.overflow = 'visible';
+      if (el.classList.contains('rank-card')) { el.style.zIndex='100'; el.style.position='relative'; }
+      el = el.parentElement;
+    }
+  }
+}
+
+document.addEventListener('click', function() {
+  document.querySelectorAll('.ddm').forEach(function(d){ d.style.display='none'; });
+});
