+<style>
+:root{--g:#E8A020;--n:#071a2e;--n2:#0a2540;--n3:#0d3b6e}
+*{box-sizing:border-box;margin:0;padding:0}
+body{background:#071a2e;font-family:'Inter',sans-serif;color:#e8edf2;min-height:100vh}
+.rank-card{border:1px solid rgba(255,255,255,0.08);border-radius:14px;background:rgba(255,255,255,0.02);overflow:hidden;margin-bottom:10px;transition:border-color 0.3s,background 0.3s}
+.rank-card.open{border-color:rgba(232,160,32,0.3);background:rgba(232,160,32,0.03);overflow:visible;z-index:100;position:relative}
