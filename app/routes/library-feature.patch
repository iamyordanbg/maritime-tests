+.rank-header:hover .rank-title{color:#E8A020}
+.epaulette{width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,#0d3b6e,#1a4a6e);border:1px solid rgba(232,160,32,0.2);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;flex-shrink:0}
